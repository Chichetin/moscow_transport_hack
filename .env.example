# Скопировать в .env (в .gitignore). Секретов в проекте нет — только пути.

# Каталог с распакованными bag-файлами (122 каталога <vehicle>_<hash>/).
# По умолчанию tools/ и docker/ берут ./dataset/data.
TRAM_DATA_DIR=./dataset/data

# Куда tools/eval и стенд жюри пишут результаты прогонов (в .gitignore).
TRAM_OUT_DIR=./out
