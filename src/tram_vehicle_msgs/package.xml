<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tram_vehicle_msgs_vendor</name>
  <version>0.0.0</version>
  <description>Builds the organizers' tram_vehicle_msgs (vendor/ + msg/) only if the workspace or underlay has none (D-044)</description>
  <maintainer email="team@example.com">Hackathon team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- jury's own tram_vehicle_msgs, if present, is built first and then used as is -->
  <build_depend>tram_vehicle_msgs</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
