<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tram_odometry_core</name>
  <version>0.0.1</version>
  <description>Tram backup odometry core: drive model, longitudinal dynamics, estimator, slip detection, positioning. Pure Python + numpy, no rclpy.</description>
  <maintainer email="team@example.com">Hackathon team</maintainer>
  <license>MIT</license>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
